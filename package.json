{
  "name": "partnerfind-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:local && wrangler dev --local --ip 127.0.0.1",
    "build": "vite build",
    "build:local": "VITE_LOCAL_ADMIN_BYPASS=true vite build",
    "start": "npm run dev",
    "preview": "npm run dev",
    "deploy": "npm run build && wrangler deploy",
    "clean": "rm -rf dist .wrangler",
    "lint": "tsc --noEmit",
    "db:local:migrate": "wrangler d1 migrations apply partnerfind-db --local",
    "db:remote:migrate": "wrangler d1 migrations apply partnerfind-db --remote"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "eslint": "^10.6.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "wrangler": "^4.42.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
